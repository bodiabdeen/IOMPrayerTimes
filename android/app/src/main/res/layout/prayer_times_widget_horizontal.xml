<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:padding="2dp"
    android:gravity="center_vertical">

    <!-- Fajr -->
    <LinearLayout
        android:id="@+id/prayer_fajr"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#10FFFFFF"
        android:layout_margin="1dp"
        android:padding="1dp">
        
        <TextView
            android:id="@+id/fajr_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fajr"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"/>
        
        <TextView
            android:id="@+id/fajr_apt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="06:09"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>
        
        <TextView
            android:id="@+id/fajr_mit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="06:30"
            android:textColor="#CCCCCC"
            android:textSize="10sp"/>
    </LinearLayout>

    <!-- Sunrise -->
    <LinearLayout
        android:id="@+id/prayer_sunrise"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#10FFFFFF"
        android:layout_margin="1dp"
        android:padding="1dp">
        
        <TextView
            android:id="@+id/sunrise_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sun"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"/>
        
        <TextView
            android:id="@+id/sunrise_apt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:18"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Dhuhr -->
    <LinearLayout
        android:id="@+id/prayer_dhuhr"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#10FFFFFF"
        android:layout_margin="1dp"
        android:padding="1dp">
        
        <TextView
            android:id="@+id/dhuhr_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dhuhr"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"/>
        
        <TextView
            android:id="@+id/dhuhr_apt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:30"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>
        
        <TextView
            android:id="@+id/dhuhr_mit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="13:25"
            android:textColor="#CCCCCC"
            android:textSize="10sp"/>
    </LinearLayout>

    <!-- Asr -->
    <LinearLayout
        android:id="@+id/prayer_asr"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#10FFFFFF"
        android:layout_margin="1dp"
        android:padding="1dp">
        
        <TextView
            android:id="@+id/asr_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asr"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"/>
        
        <TextView
            android:id="@+id/asr_apt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14:18"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>
        
        <TextView
            android:id="@+id/asr_mit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14:23"
            android:textColor="#CCCCCC"
            android:textSize="10sp"/>
    </LinearLayout>

    <!-- Maghrib -->
    <LinearLayout
        android:id="@+id/prayer_maghrib"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#10FFFFFF"
        android:layout_margin="1dp"
        android:padding="1dp">
        
        <TextView
            android:id="@+id/maghrib_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Magh"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"/>
        
        <TextView
            android:id="@+id/maghrib_apt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="16:43"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>
        
        <TextView
            android:id="@+id/maghrib_mit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="16:48"
            android:textColor="#CCCCCC"
            android:textSize="10sp"/>
    </LinearLayout>

    <!-- Isha -->
    <LinearLayout
        android:id="@+id/prayer_isha"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#10FFFFFF"
        android:layout_margin="1dp"
        android:padding="1dp">
        
        <TextView
            android:id="@+id/isha_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Isha"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"/>
        
        <TextView
            android:id="@+id/isha_apt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18:13"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>
        
        <TextView
            android:id="@+id/isha_mit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="19:30"
            android:textColor="#CCCCCC"
            android:textSize="10sp"/>
    </LinearLayout>

</LinearLayout>